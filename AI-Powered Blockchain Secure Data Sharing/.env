# ── Ganache (local blockchain) ────────────────────────────────────────────────
GANACHE_URL=http://127.0.0.1:7545
# If you used npm ganache-cli, change to http://127.0.0.1:8545
NETWORK_ID=5777

# ── Pinata (IPFS online storage) ──────────────────────────────────────────────
# Get these free at https://app.pinata.cloud → API Keys → New Key
# Give the key: pinFileToIPFS + unpin permissions
PINATA_API_KEY=9f2b2988555b80435100
PINATA_API_SECRET=75bec1c0aa837f028a76dfbd8020d11fe0cce6ccd27f96f1b7cbf56dc63e94a6

# ── How to set up Pinata (one-time, 5 minutes): ───────────────────────────────
# 1. Go to https://app.pinata.cloud and create a free account
# 2. Click "API Keys" in the left menu
# 3. Click "New Key"
# 4. Enable: pinFileToIPFS + unpin
# 5. Click Generate → copy the API Key and API Secret
# 6. Paste them above replacing the placeholder text
# 7. Save this file
# Free plan: 1 GB storage, unlimited retrievals — plenty for a demo project